# =============================================================================
# AI Blog Pipeline — Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# --- REQUIRED ---

# Anthropic Claude API (powers all agents)
ANTHROPIC_API_KEY=sk-ant-...

# WordPress REST API
WORDPRESS_URL=https://yourblog.com
WORDPRESS_USERNAME=your-username
WORDPRESS_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# --- RECOMMENDED ---

# DataForSEO (keyword research, People Also Ask)
# ~$5/month pay-as-you-go — https://dataforseo.com
DATAFORSEO_LOGIN=your-login
DATAFORSEO_PASSWORD=your-password

# OpenAI API (DALL-E 3 featured images)
# ~$1/month — https://platform.openai.com
OPENAI_API_KEY=sk-...

# IndexNow (fast search engine indexing)
# Free — generate key at https://www.indexnow.org
INDEXNOW_API_KEY=your-indexnow-key

# --- OPTIONAL ---

# Buffer (social media auto-posting)
# $6/month — https://buffer.com
BUFFER_ACCESS_TOKEN=your-buffer-token

# Google Search Console API (ranking data for Auditor)
# Free — service account JSON key file path
GSC_CREDENTIALS_PATH=./config/gsc-credentials.json

# Google Analytics 4 API (traffic data for Auditor)
# Free — service account JSON key file path
GA4_CREDENTIALS_PATH=./config/ga4-credentials.json
GA4_PROPERTY_ID=properties/123456789

# --- BLOG CONFIGURATION ---

# Author info (used in schema markup)
BLOG_AUTHOR_NAME=Your Name
BLOG_AUTHOR_URL=https://yourblog.com/about
BLOG_NAME=Your Blog Name
BLOG_LOGO_URL=https://yourblog.com/logo.png

# Featured image style
IMAGE_STYLE=dark background, teal accents (#2EBFAC), minimal, modern

# Social media
LINKEDIN_PROFILE_URL=https://linkedin.com/in/yourprofile
TWITTER_HANDLE=@yourhandle
